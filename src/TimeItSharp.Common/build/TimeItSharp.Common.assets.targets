<Project>
  <PropertyGroup>
    <_TimeItSharpCommonTargetsImported>true</_TimeItSharpCommonTargetsImported>
  </PropertyGroup>

  <!-- Assets live outside contentFiles to avoid NETSDK1152 collisions. Explicit late copies
       make the pinned v2 payload win if a direct v3 package contributes the same names. -->
  <Target Name="TimeItSharpCopyTrustedAssetsToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="Exists('$(TimeItSharpDatadogAssetsDirectory)') and '$(TargetDir)' != ''">
    <ItemGroup>
      <_TimeItSharpDatadogAsset Include="$(TimeItSharpDatadogAssetsDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TimeItSharpDatadogAsset)"
          DestinationFiles="@(_TimeItSharpDatadogAsset->'$(TargetDir)datadog\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TimeItSharpStartupHookFile)"
          DestinationFiles="$(TargetDir)TimeItSharp.StartupHook.dll"
          SkipUnchangedFiles="false"
          Condition="Exists('$(TimeItSharpStartupHookFile)')" />
  </Target>

  <Target Name="TimeItSharpCopyTrustedAssetsToPublish"
          AfterTargets="Publish"
          Condition="Exists('$(TimeItSharpDatadogAssetsDirectory)') and '$(PublishDir)' != ''">
    <ItemGroup>
      <_TimeItSharpDatadogPublishAsset Include="$(TimeItSharpDatadogAssetsDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TimeItSharpDatadogPublishAsset)"
          DestinationFiles="@(_TimeItSharpDatadogPublishAsset->'$(PublishDir)datadog\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TimeItSharpStartupHookFile)"
          DestinationFiles="$(PublishDir)TimeItSharp.StartupHook.dll"
          SkipUnchangedFiles="false"
          Condition="Exists('$(TimeItSharpStartupHookFile)')" />
  </Target>
</Project>
